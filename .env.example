# Public Turnstile site key. Use Cloudflare's documented always-pass test pair locally only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only contact pipeline configuration.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_REPLY_TO_EMAIL=

# At least 16 random characters. Used only to hash source addresses before persistence.
RATE_LIMIT_SALT=

# Comma-separated allowlist for the single-owner admin.
ADMIN_EMAILS=
ADMIN_ALLOWED_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:5173
NEXTAUTH_URL_INTERNAL=http://localhost:5173

# Public canonical origin, without a trailing slash.
SITE_URL=http://localhost:5173

# Set false to disable first-party, cookieless event collection.
ANALYTICS_ENABLED=true
