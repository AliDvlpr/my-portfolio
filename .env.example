# Public Turnstile site key. Cloudflare's documented test key is suitable for local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only contact pipeline configuration.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_REPLY_TO_EMAIL=

# At least 16 random characters. Used only to hash source addresses before persistence.
RATE_LIMIT_SALT=

# Comma-separated allowlist for the single-owner admin.
ADMIN_EMAILS=

# Public canonical origin, without a trailing slash.
SITE_URL=http://localhost:5173

# Set false to disable first-party, cookieless event collection.
ANALYTICS_ENABLED=true
